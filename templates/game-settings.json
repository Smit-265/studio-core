{
  "_comment": "Generated by studio-core (check-loaders.py --write). Do not edit; the source is templates/game-settings.json. Hooks make CLAUDE.md's rules mechanical - see scripts/hooks/guard.py. STUDIO_GUARD=off in the environment disables them.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${STUDIO_CORE:-../studio-core}/scripts/hooks/guard.sh\" session-start" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${STUDIO_CORE:-../studio-core}/scripts/hooks/guard.sh\" scope" }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "bash \"${STUDIO_CORE:-../studio-core}/scripts/hooks/guard.sh\" sequential" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${STUDIO_CORE:-../studio-core}/scripts/hooks/guard.sh\" git-tree" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "bash \"${STUDIO_CORE:-../studio-core}/scripts/hooks/guard.sh\" agent-done" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${STUDIO_CORE:-../studio-core}/scripts/hooks/guard.sh\" agent-done" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${STUDIO_CORE:-../studio-core}/scripts/hooks/guard.sh\" stop-state" }
        ]
      }
    ]
  }
}
